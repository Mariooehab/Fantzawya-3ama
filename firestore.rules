rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function validReligion(value) { return value in ['muslim', 'christian']; }
    function validPrayerSettings(value) {
      return value is map
        && value.keys().hasOnly(['city','country','enabled'])
        && value.keys().hasAll(['city','country','enabled'])
        && value.city is string && value.city.size() > 0 && value.city.size() <= 80
        && value.country is string && value.country.size() > 0 && value.country.size() <= 80
        && value.enabled is bool;
    }
    function validPrayerReminder(reminderId, reminder) {
      return reminderId.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && reminder.keys().hasOnly(['title','time','enabled','updatedAt'])
        && reminder.keys().hasAll(['title','time','enabled','updatedAt'])
        && reminder.title is string && reminder.title.size() > 0 && reminder.title.size() <= 80
        && reminder.time == reminderId
        && reminder.enabled is bool
        && reminder.updatedAt == request.time;
    }
    function leagueMember(leagueId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
    }
    function studyRoomInvitePath(roomId, userId) {
      let inviteId = roomId + '_' + userId;
      return /databases/$(database)/documents/studyRoomInvites/$(inviteId);
    }
    function studyRoomElapsedSeconds(room, endAt) {
      let startedMillis = room.startedAt.toMillis();
      let requestedEndMillis = endAt.toMillis();
      let targetMillis = room.mode == 'countdown'
        ? startedMillis + room.durationSeconds * 1000
        : room.mode == 'until' && room.targetEndAt is timestamp
          ? room.targetEndAt.toMillis()
          : requestedEndMillis;
      let effectiveEndMillis = targetMillis < requestedEndMillis ? targetMillis : requestedEndMillis;
      let seconds = math.floor((effectiveEndMillis - startedMillis) / 1000);
      return seconds < 0 ? 0 : seconds;
    }
    function validParticipantEvent(action, participantUid) {
      let event = request.resource.data.lastParticipantEvent;
      return request.resource.data.participantEventRevision == resource.data.get('participantEventRevision', 0) + 1
        && event is map
        && event.keys().hasOnly(['uid','actorUid','action','revision','createdAt'])
        && event.uid == participantUid
        && event.actorUid == request.auth.uid
        && event.action == action
        && event.revision == request.resource.data.participantEventRevision
        && event.createdAt == request.time;
    }

    match /users/{userId} {
      allow create: if owner(userId)
        && request.resource.data.keys().hasOnly(['username','email','createdAt','xp','streak','status','avatarUrl','coverUrl','studyTimeZone','ownerSuggestionSeen','ownerSuggestionSeenAt','religion','prayerSettings'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.xp is int && request.resource.data.xp == 0
        && request.resource.data.streak is int && request.resource.data.streak == 0
        && 'religion' in request.resource.data
        && validReligion(request.resource.data.religion)
        && (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl is string)
        && (!('coverUrl' in request.resource.data) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 2000))
        && (!('studyTimeZone' in request.resource.data) || (request.resource.data.studyTimeZone is string && request.resource.data.studyTimeZone.size() <= 64))
        && (!('prayerSettings' in request.resource.data) || validPrayerSettings(request.resource.data.prayerSettings));
      allow read: if owner(userId);
      allow update: if owner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username','avatarUrl','coverUrl','email','studyTimeZone','ownerSuggestionSeen','ownerSuggestionSeenAt','religion','prayerSettings'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) || (request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 20))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarUrl']) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 2000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coverUrl']) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 2000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) || request.resource.data.email == request.auth.token.email)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studyTimeZone']) || (request.resource.data.studyTimeZone is string && request.resource.data.studyTimeZone.size() <= 64))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerSuggestionSeen']) || request.resource.data.ownerSuggestionSeen is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerSuggestionSeenAt']) || request.resource.data.ownerSuggestionSeenAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['religion']) || validReligion(request.resource.data.religion))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['prayerSettings']) || validPrayerSettings(request.resource.data.prayerSettings));
      allow delete: if false;

      match /prayerReminders/{reminderId} {
        allow read: if owner(userId);
        allow create: if owner(userId) && validPrayerReminder(reminderId, request.resource.data);
        allow update: if owner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','time','enabled','updatedAt'])
          && validPrayerReminder(reminderId, request.resource.data);
        allow delete: if owner(userId);
      }

      match /friendSettings/{friendUid} {
        allow read, delete: if owner(userId) && friendUid != userId;
        allow create, update: if owner(userId) && friendUid != userId
          && request.resource.data.keys().hasOnly(['favorite','updatedAt'])
          && request.resource.data.favorite is bool
          && request.resource.data.updatedAt == request.time;
      }
      match /challenges/{challengeId} {
        allow read: if owner(userId);
        allow create: if owner(userId)
          && request.resource.data.keys().hasOnly(['challengeId','title','joinedAt'])
          && request.resource.data.challengeId == challengeId
          && request.resource.data.title is string
          && request.resource.data.joinedAt == request.time;
        allow update, delete: if false;
      }
      match /todos/{todoId} {
        allow read: if owner(userId);
        allow create: if owner(userId)
          && request.resource.data.keys().hasOnly(['title','note','dueAt','completed','createdAt','updatedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
          && request.resource.data.note is string && request.resource.data.note.size() <= 1000
          && request.resource.data.dueAt is string
          && request.resource.data.completed == false
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if owner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','updatedAt'])
          && request.resource.data.completed is bool && request.resource.data.updatedAt == request.time;
        allow delete: if owner(userId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['uid','username','usernameLower','avatarUrl','coverUrl','studyTimeZone','isOwner','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','username','usernameLower','avatarUrl','coverUrl','updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower is string
        && request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 2000
        && (!('studyTimeZone' in request.resource.data) || (request.resource.data.studyTimeZone is string && request.resource.data.studyTimeZone.size() <= 64))
        && (!('isOwner' in request.resource.data) || request.resource.data.isOwner is bool)
        && request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderUid','senderUsername','senderAvatarUrl','recipientUid','recipientUsername','recipientAvatarUrl','status','createdAt'])
        && request.resource.data.keys().hasAll(['senderUid','senderUsername','senderAvatarUrl','recipientUid','recipientUsername','recipientAvatarUrl','status','createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.senderUsername is string && request.resource.data.recipientUsername is string
        && request.resource.data.senderAvatarUrl is string && request.resource.data.recipientAvatarUrl is string
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.respondedAt == request.time
        && ((resource.data.recipientUid == request.auth.uid && resource.data.status == 'pending'
             && request.resource.data.status in ['accepted','rejected'])
          || ((resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid)
             && resource.data.status == 'accepted' && request.resource.data.status == 'removed'));
      allow delete: if false;
    }

    match /studySessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid','username','mode','plannedSeconds','startedAt','status','pausedSeconds','durationSeconds'])
        && request.resource.data.keys().hasOnly(['uid','username','mode','plannedSeconds','startedAt','status','pausedSeconds','durationSeconds'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 20
        && request.resource.data.mode in ['countdown','stopwatch']
        && request.resource.data.plannedSeconds is int && request.resource.data.plannedSeconds >= 0 && request.resource.data.plannedSeconds <= 86400
        && ((request.resource.data.mode == 'countdown' && request.resource.data.plannedSeconds >= 1) || (request.resource.data.mode == 'stopwatch' && request.resource.data.plannedSeconds == 0))
        && request.resource.data.startedAt == request.time && request.resource.data.status == 'active'
        && request.resource.data.pausedSeconds == 0 && request.resource.data.durationSeconds == 0;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt','status','durationSeconds','pausedSeconds','plannedSeconds'])
        && request.resource.data.keys().hasAll(['endedAt','status','durationSeconds','pausedSeconds','plannedSeconds'])
        && request.resource.data.endedAt == request.time && request.resource.data.status == 'completed'
        && request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 1 && request.resource.data.durationSeconds <= 604800
        && request.resource.data.pausedSeconds is int && request.resource.data.pausedSeconds >= 0 && request.resource.data.pausedSeconds <= 604800
        && request.resource.data.pausedSeconds <= math.floor((request.time.toMillis() - resource.data.startedAt.toMillis()) / 1000)
        && request.resource.data.durationSeconds + request.resource.data.pausedSeconds <= math.floor((request.time.toMillis() - resource.data.startedAt.toMillis()) / 1000)
        && request.resource.data.plannedSeconds is int && request.resource.data.plannedSeconds >= 0 && request.resource.data.plannedSeconds <= 86400
        && ((request.resource.data.mode == 'countdown' && request.resource.data.plannedSeconds >= 1) || (request.resource.data.mode == 'stopwatch' && request.resource.data.plannedSeconds == 0))
        && request.time > resource.data.startedAt;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'completed';
    }

    match /leagues/{leagueId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','ownerUid','inviteCode','memberUids','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 32
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() == 8
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.hasAll([request.auth.uid])
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /tasks/{taskId} {
        allow read: if leagueMember(leagueId);
        allow create: if leagueMember(leagueId)
          && request.resource.data.keys().hasOnly(['title','createdBy','createdAt','completedBy'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.completedBy == [];
        allow update: if leagueMember(leagueId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedBy'])
          && request.resource.data.completedBy is list
          && request.resource.data.completedBy.hasAll(resource.data.completedBy)
          && request.resource.data.completedBy.hasAll([request.auth.uid])
          && request.resource.data.completedBy.size() == resource.data.completedBy.size() + 1;
        allow delete: if false;
      }
    }

    match /studyRooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','ownerUid','ownerUsername','memberUids','readyUids','pausedAt','pausedSeconds','mode','durationSeconds','targetEndAt','status','createdAt','startedAt','endedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 48
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUsername is string && request.resource.data.ownerUsername.size() <= 20
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.readyUids == []
        && request.resource.data.pausedAt == null
        && request.resource.data.pausedSeconds == 0
        && request.resource.data.mode in ['stopwatch','countdown','until']
        && request.resource.data.durationSeconds is int
        && ((request.resource.data.mode == 'countdown' && request.resource.data.durationSeconds >= 60 && request.resource.data.durationSeconds <= 86400)
          || (request.resource.data.mode != 'countdown' && request.resource.data.durationSeconds == 0))
        && ((request.resource.data.mode == 'until' && request.resource.data.targetEndAt is timestamp
              && request.resource.data.targetEndAt > request.time
              && request.resource.data.targetEndAt.toMillis() <= request.time.toMillis() + 604800000)
          || (request.resource.data.mode != 'until' && request.resource.data.targetEndAt == null))
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time
        && request.resource.data.startedAt == null && request.resource.data.endedAt == null;
      allow read: if signedIn() && (request.auth.uid in resource.data.memberUids
        || (resource.data.ownerUid == request.auth.uid && resource.data.status == 'ending')
        || (exists(studyRoomInvitePath(roomId, request.auth.uid))
          && get(studyRoomInvitePath(roomId, request.auth.uid)).data.status == 'pending'
          && get(studyRoomInvitePath(roomId, request.auth.uid)).data.roomId == roomId));
      allow update: if signedIn() && (
        (
          resource.data.status in ['waiting','active']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && resource.data.ownerUid == request.resource.data.ownerUid
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && !(request.auth.uid in resource.data.get('kickedUids', []))
          && request.resource.data.memberUids.size() <= 100
          && get(studyRoomInvitePath(roomId, request.auth.uid)).data.status == 'pending'
          && get(studyRoomInvitePath(roomId, request.auth.uid)).data.recipientUid == request.auth.uid
          && get(studyRoomInvitePath(roomId, request.auth.uid)).data.roomId == roomId
          && get(studyRoomInvitePath(roomId, request.auth.uid)).data.senderUid == resource.data.ownerUid
          && getAfter(studyRoomInvitePath(roomId, request.auth.uid)).data.status == 'accepted'
          && getAfter(studyRoomInvitePath(roomId, request.auth.uid)).data.respondedAt == request.time
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.auth.uid in resource.data.memberUids
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','startedAt'])
          && request.resource.data.startedAt == request.time
          && ((resource.data.mode == 'until' && resource.data.targetEndAt is timestamp && resource.data.targetEndAt > request.time)
            || resource.data.mode != 'until'
            || resource.data.targetEndAt is string)
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.auth.uid in resource.data.memberUids
          && resource.data.status == 'active'
          && request.resource.data.status == 'ending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endRequestedAt','autoEnded'])
          && request.resource.data.endRequestedAt == request.time
          && request.resource.data.autoEnded is bool
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'ending'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt','finalSeconds'])
          && request.resource.data.endedAt == resource.data.endRequestedAt
          && request.resource.data.finalSeconds is int
          && request.resource.data.finalSeconds == studyRoomElapsedSeconds(resource.data, resource.data.endRequestedAt)
        )
        || (
          resource.data.status in ['waiting','active']
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.resource.data.get('kickedUids', []) == resource.data.get('kickedUids', [])
          && validParticipantEvent('left', request.auth.uid)
          && (
            (
              resource.data.ownerUid != request.auth.uid
              && request.resource.data.ownerUid == resource.data.ownerUid
              && request.resource.data.status == resource.data.status
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','participantEventRevision','lastParticipantEvent'])
            )
            || (
              resource.data.ownerUid == request.auth.uid
              && request.resource.data.memberUids.size() > 0
              && request.resource.data.ownerUid in request.resource.data.memberUids
              && request.resource.data.ownerUid != resource.data.ownerUid
              && (
                (exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.ownerUid))
                  && request.resource.data.ownerUsername == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.ownerUid)).data.username)
                || (!exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.ownerUid))
                  && request.resource.data.ownerUsername == 'Member')
              )
              && request.resource.data.status == resource.data.status
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','participantEventRevision','lastParticipantEvent','ownerUid','ownerUsername'])
            )
            || (
              resource.data.ownerUid == request.auth.uid
              && request.resource.data.memberUids.size() == 0
              && request.resource.data.ownerUid == resource.data.ownerUid
              && resource.data.status == 'waiting'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.endedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','participantEventRevision','lastParticipantEvent','status','endedAt'])
            )
            || (
              resource.data.ownerUid == request.auth.uid
              && request.resource.data.memberUids.size() == 0
              && request.resource.data.ownerUid == resource.data.ownerUid
              && resource.data.status == 'active'
              && request.resource.data.status == 'completed'
              && request.resource.data.endedAt == request.time
              && request.resource.data.finalSeconds is int
              && math.abs(request.resource.data.finalSeconds - studyRoomElapsedSeconds(resource.data, request.time)) <= 2
              && request.resource.data.autoEnded == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','participantEventRevision','lastParticipantEvent','status','endedAt','finalSeconds','autoEnded'])
            )
          )
        )
        || (
          resource.data.ownerUid == request.auth.uid
          && request.auth.uid in resource.data.memberUids
          && resource.data.status in ['waiting','active']
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','kickedUids','participantEventRevision','lastParticipantEvent'])
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.kickedUids is list
          && request.resource.data.kickedUids.hasAll(resource.data.get('kickedUids', []))
          && request.resource.data.kickedUids.size() == resource.data.get('kickedUids', []).size() + 1
          && validParticipantEvent('kicked', request.resource.data.lastParticipantEvent.uid)
          && request.resource.data.lastParticipantEvent.uid == request.resource.data.kickedUids[resource.data.get('kickedUids', []).size()]
          && request.resource.data.lastParticipantEvent.uid in resource.data.memberUids
          && !(request.resource.data.lastParticipantEvent.uid in request.resource.data.memberUids)
          && !(request.resource.data.lastParticipantEvent.uid in resource.data.get('kickedUids', []))
        )
      );

      match /privateChats/{chatId}/messages/{messageId} {
        function privateChatParticipants() {
          return signedIn()
            && request.resource.data.senderUid is string
            && request.resource.data.recipientUid is string
            && request.resource.data.senderUid != request.resource.data.recipientUid
            && request.resource.data.senderUid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids
            && request.resource.data.recipientUid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids
            && request.auth.uid in [request.resource.data.senderUid, request.resource.data.recipientUid]
            && (chatId == request.resource.data.senderUid + '_' + request.resource.data.recipientUid
              || chatId == request.resource.data.recipientUid + '_' + request.resource.data.senderUid);
        }
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids
          && resource.data.senderUid is string
          && resource.data.recipientUid is string
          && request.auth.uid in [resource.data.senderUid, resource.data.recipientUid];
        allow create: if privateChatParticipants()
          && request.resource.data.keys().hasOnly(['senderUid','recipientUid','senderUsername','text','createdAt'])
          && request.resource.data.senderUsername is string
          && request.resource.data.senderUsername.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        function roomMember() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids;
        }
        allow read: if roomMember();
        allow create: if roomMember()
          && request.resource.data.keys().hasOnly(['senderUid','senderUsername','text','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUsername is string
          && request.resource.data.senderUsername.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid
        && resource.data.status in ['completed','cancelled'];
    }

    match /studyRoomRemovals/{removalId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId','uid','roomName','type','createdAt'])
        && request.resource.data.roomId is string
        && request.resource.data.uid is string
        && removalId == request.resource.data.roomId + '_' + request.resource.data.uid
        && request.resource.data.type == 'kicked'
        && request.resource.data.roomName is string
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.status in ['waiting','active']
        && request.resource.data.uid in get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids
        && request.resource.data.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.kickedUids
        && !(request.resource.data.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids)
        && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.uid == request.resource.data.uid
        && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.action == 'kicked';
      allow update, delete: if false;
    }

    match /studyRoomCompletions/{completionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId','uid','durationSeconds','mode','startedAt','endedAt','completedAt'])
        && request.resource.data.roomId is string
        && request.resource.data.uid is string
        && completionId == request.resource.data.roomId + '_' + request.resource.data.uid
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 604800
        && request.resource.data.mode in ['stopwatch','countdown','until']
        && request.resource.data.startedAt is timestamp
        && request.resource.data.endedAt is timestamp
        && request.resource.data.completedAt == request.resource.data.endedAt
        && (
          (
            request.resource.data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.status == 'completed'
            && request.resource.data.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids
            && request.resource.data.durationSeconds == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.finalSeconds
            && request.resource.data.mode == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.mode
            && request.resource.data.startedAt == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.startedAt
            && request.resource.data.endedAt == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.endedAt
          )
          || (
            request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.status == 'active'
            && request.resource.data.mode == get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.mode
            && request.resource.data.startedAt == get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.startedAt
            && request.resource.data.endedAt == request.time
            && math.abs(request.resource.data.durationSeconds - studyRoomElapsedSeconds(get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data, request.time)) <= 2
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.action == 'left'
            && !(request.auth.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids)
          )
          || (
            get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid
            && get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.status == 'active'
            && request.resource.data.mode == get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.mode
            && request.resource.data.startedAt == get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.startedAt
            && request.resource.data.endedAt == request.time
            && math.abs(request.resource.data.durationSeconds - studyRoomElapsedSeconds(get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data, request.time)) <= 2
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.uid == request.resource.data.uid
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.actorUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.action == 'kicked'
            && request.resource.data.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.kickedUids
            && !(request.resource.data.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids)
          )
          || (
            request.resource.data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.status == 'completed'
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.lastParticipantEvent.action == 'left'
            && request.resource.data.durationSeconds == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.finalSeconds
            && request.resource.data.mode == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.mode
            && request.resource.data.startedAt == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.startedAt
            && request.resource.data.endedAt == getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.endedAt
            && !(request.auth.uid in getAfter(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids)
          )
        );
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /studyRoomInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId','roomName','mode','senderUid','senderUsername','recipientUid','status','createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.mode in ['stopwatch','countdown','until']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && inviteId == request.resource.data.roomId + '_' + request.resource.data.recipientUid
        && get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.status in ['waiting','active']
        && request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(request.resource.data.roomId)).data.memberUids;
      allow read: if signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.respondedAt == request.time
        && (request.resource.data.status == 'declined'
          || (
            getAfter(/databases/$(database)/documents/studyRooms/$(resource.data.roomId)).data.status in ['waiting','active']
            && request.auth.uid in getAfter(/databases/$(database)/documents/studyRooms/$(resource.data.roomId)).data.memberUids
            && !(request.auth.uid in getAfter(/databases/$(database)/documents/studyRooms/$(resource.data.roomId)).data.get('kickedUids', []))
          ));
      allow delete: if false;
    }

  }
}
